# Configuração do contador de acessos (o instalar.sh cria /etc/radar-contador.env a partir deste arquivo)

# site que pode enviar visitas e abrir o painel (separe vários com vírgula)
CONTADOR_ORIGENS=https://llourencodev.github.io

# login do painel de acessos: NÃO edite à mão; crie ou troque com
#   sudo python3 /opt/radar-contador/servidor.py --definir-senha
CONTADOR_USUARIO=
CONTADOR_SENHA_HASH=

# por quantos dias o login fica lembrado no navegador
CONTADOR_SESSAO_DIAS=30

# porta local (o túnel da Cloudflare ou do Tailscale aponta para ela; não abra no roteador)
CONTADOR_PORTA=8787

# quantos dias de visitas guardar
CONTADOR_DIAS=400

CONTADOR_BANCO=/var/lib/radar-contador/acessos.db
CONTADOR_FUSO=America/Sao_Paulo
