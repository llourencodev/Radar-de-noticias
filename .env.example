# Copie este arquivo para ".env" e ajuste o que quiser. Tudo é opcional.

# ---------------- Servidor
RADAR_HOST=127.0.0.1
RADAR_PORT=8000

# ---------------- Atualização automática
# Intervalo padrão (minutos) entre coletas de cada fonte
RADAR_INTERVAL_MIN=60
# true = coleta sozinho; false = só pelo botão "Atualizar"
RADAR_AUTO_UPDATE=true
# Coletar assim que o programa abrir
RADAR_COLLECT_ON_START=true
# Fontes coletadas em paralelo
RADAR_WORKERS=6

# ---------------- Recência (itens mais antigos que isso não entram como novidade)
RADAR_MAX_AGE_DAYS=30
RADAR_FISCAL_MAX_AGE_DAYS=120

# ---------------- Leitura das páginas originais (imagem, data, texto para resumo)
RADAR_FETCH_PAGES=true
RADAR_PAGE_BUDGET=15
RADAR_GOOGLE_DECODE_BUDGET=12
RADAR_HOST_MIN_INTERVAL=1.0

# ---------------- IA (opcional). Valores: none | anthropic | openai | ollama
LLM_PROVIDER=none
# Claude (Anthropic) — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# OpenAI ou qualquer API compatível
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Ollama local (gratuito) — https://ollama.com
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Máximo de notícias processadas pela IA por coleta (controla custo)
LLM_MAX_PER_RUN=40
